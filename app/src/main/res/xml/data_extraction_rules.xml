<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="sleepbot.db" />
        <include domain="sharedpref" path="sleepbot.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="sleepbot.db" />
        <include domain="sharedpref" path="sleepbot.xml" />
        <include domain="file" path="sounds/" />
    </device-transfer>
</data-extraction-rules>
